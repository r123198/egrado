# ── Flutter / Dart build output and caches ─────────────────────────────
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
coverage/
*.g.dart.tmp

# Generated by Flutter on every build (also covered per platform)
**/Flutter/ephemeral/
**/GeneratedPluginRegistrant.*

# Symbolication / obfuscation maps from release builds
app.*.symbols
app.*.map.json
debug-info/

# Android build caches (android/.gitignore covers the rest)
android/.kotlin/
android/app/debug/
android/app/profile/
android/app/release/

# ── FVM: the SDK itself is downloaded per machine; .fvmrc is committed ──
.fvm/

# ── Editors and OS ─────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
# Keep the shared VS Code setting that points at the FVM Flutter SDK.
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp
*.log

# ── AI assistant / personal tooling (not part of the app) ──────────────
.claude/
.icode/

# ── Secrets: never commit ──────────────────────────────────────────────
.env
.env.*
*.keystore
*.jks
key.properties

# ── Reference material, not app source ─────────────────────────────────
# Original ZipGrade forms (trademarked); the app ships its own sheets in
# answer_sheets/ and generates printable ones in lib/sheet/.
ZipGrade*.pdf
ZipGrade*.png

# ── Firebase client config (holds API keys) ────────────────────────────
# Generate locally with:  flutterfire configure --project=egrado-dddb4
# (firebase.json, which has no keys, stays committed so this works.)
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
